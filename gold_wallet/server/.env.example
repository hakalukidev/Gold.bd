# Server
NODE_ENV=development
# NODE_ENV=production
PORT=4000

# Postgres connection string, e.g. postgres://user:password@localhost:5432/gold_wallet
# This is the migration-runner connection (DDL rights) — `npm run migrate`
# always uses this one. In production, point MIGRATE_DATABASE_URL below at
# the same DDL-capable role and make DATABASE_URL the restricted app-runtime
# role instead (see db/roles/grant-app-role.sql).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gold_wallet
# Optional: only needed once you've split DB roles (see db/roles/grant-app-role.sql).
# Defaults to DATABASE_URL, which is fine for local dev.
MIGRATE_DATABASE_URL=
# Set to true only if your Postgres provider requires SSL (most managed hosts do).
# Required (must be true) when NODE_ENV=production.
DATABASE_SSL=false

# Application-level field encryption + tamper-evidence keys (src/security/crypto.js).
# Protects wallet balances, payment/OTP PII, and user contact info at rest.
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# All three are REQUIRED and must be 64-char hex strings (32 bytes). Never
# commit real values — losing ENCRYPTION_KEY_V1 (or a later version once
# rotated to) makes everything encrypted under it permanently unreadable, so
# back it up somewhere durable (a secrets manager/KMS in production).
CURRENT_KEY_VERSION=1
ENCRYPTION_KEY_V1=replace-with-a-generated-64-char-hex-key
# ENCRYPTION_KEY_V2=set-only-after-rotating-to-a-new-current-version
INTEGRITY_KEY=replace-with-a-different-generated-64-char-hex-key
HMAC_BLIND_INDEX_KEY=replace-with-another-generated-64-char-hex-key

# Comma-separated list of origins allowed to call this API with credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Secrets used to sign JWTs. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters and MUST differ from each other. Never commit real values.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret

# Token lifetimes
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL_DAYS=30

# bcrypt cost factor. 12 is a good default; raise as hardware allows.
BCRYPT_SALT_ROUNDS=12

# Failed-login lockout policy
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# BulkSMSBD (http://bulksmsbd.net/api/smsapi) sends registration/login OTPs.
# Required when NODE_ENV=production. Left blank in development: OTPs are
# logged to the console instead of actually being sent, so local dev never
# needs live SMS credentials or spends real credits.
BULKSMSBD_API_KEY=X5aOV43zsPKaF38WvTLn
BULKSMSBD_SENDER_ID=8809648910771
BULKSMSBD_API_URL=https://bulksmsbd.net/api/smsapi
BULKSMSBD_TIMEOUT_MS=8000

# OTP policy
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# BAJUS (Bangladesh Jewellers Association) gold/silver rate feed, polled by
# src/jobs/rate-sync.job.js and served back out at /api/gold and /api/silver.
BAJUS_API_URL=https://bajusrate.com/wp-content/bajus/index.php?gold=data
RATE_SYNC_INTERVAL_MINUTES=30

# Local phone number (no "88" prefix) texted whenever a sync detects a price
# change. Optional — leave blank to only log rate changes.
ADMIN_ALERT_PHONE=

# Live USD/EUR/GBP/SAR -> BDT quotes for the wallet's "value in other
# currencies" card, polled by src/jobs/fx-sync.job.js and served back out at
# /api/fx/rates. open.er-api.com is free and needs no API key.
FX_API_URL=https://open.er-api.com/v6/latest/USD
FX_SYNC_INTERVAL_MINUTES=60

# SSLCommerz payment gateway (src/modules/payments) — the one payment
# integration both gold_commerce (checkout) and gold_wallet/client (wallet
# top-up) go through; neither app talks to SSLCommerz directly. Get sandbox
# credentials at https://developer.sslcommerz.com/registration/.
SSLCOMMERZ_STORE_ID=hakal6a9d140339c9d
SSLCOMMERZ_STORE_PASSWORD=YOUR_STORE_PASSWORD
# Flip to true (and point the two URLs below at securepay.sslcommerz.com)
# only once you have a live merchant account.
SSLCOMMERZ_IS_LIVE=false
SSLCOMMERZ_API_URL=https://sandbox.sslcommerz.com/gwprocess/v4/api.php
SSLCOMMERZ_VALIDATION_URL=https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php

# This server's own publicly-reachable origin — SSLCommerz redirects/posts
# back to <APP_BASE_URL>/api/payments/{success,fail,cancel,ipn}. Must be a
# real internet-reachable URL in production (tunnel it locally, e.g. with
# ngrok, if you need to test a full SSLCommerz round-trip in dev).
APP_BASE_URL=http://localhost:4000
